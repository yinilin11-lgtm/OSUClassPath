@using Microsoft.AspNetCore.Identity
@using OSUClassPath.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OSU CoursePath</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OSUClassPath.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">OSU CoursePath</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/" data-i18n="navHome">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Courses" data-i18n="navCourses">Courses</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Chat" data-i18n="navAdvisor">Course Advisor</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Planner" data-i18n="navPlanner">Planner</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Home/Privacy" data-i18n="navAbout">About</a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/StudentCourses" data-i18n="navMyCourses">My Courses</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Admin/Login" data-i18n="navAdmin">Admin</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav account-nav">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark account-name" href="/Account/Profile" data-i18n="navProfile">Profile</a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link text-dark nav-button" data-i18n="logout">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Account/Login" data-i18n="loginButton">Log in</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Account/Register" data-i18n="createAccount">Create account</a>
                            </li>
                        }
                    </ul>

                    <div class="language-toggle nav-language-toggle" aria-label="Language">
                        <button type="button" class="active" data-agent-language="en">EN</button>
                        <button type="button" data-agent-language="zh">中文</button>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - OSU CoursePath - <a asp-area="" asp-controller="Home" asp-action="Privacy">About</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
