@{
    ViewData["Title"] = "Home";
}

<section class="home-hero">
    <div class="home-hero-copy">
        <span class="section-label">AI-powered course information assistant</span>
        <h1>OSU CoursePath</h1>
        <p>
            An AI-powered course information assistant designed for Ohio State University students.
            Explore structured course data, manage student profiles, track selected classes, and ask
            an AI advisor for academic planning support.
        </p>
        <div class="home-actions">
            <a class="btn btn-primary" asp-controller="Chat" asp-action="Index">Open Course Advisor</a>
            <a class="btn btn-outline-primary" asp-controller="Courses" asp-action="Index">Browse Courses</a>
        </div>
    </div>
    <div class="home-status">
        <div>
            <span class="status-label">Framework</span>
            <strong>ASP.NET Core MVC</strong>
        </div>
        <div>
            <span class="status-label">Database</span>
            <strong>SQLite + EF Core</strong>
        </div>
        <div>
            <span class="status-label">AI Workflow</span>
            <strong>Gemini API integration</strong>
        </div>
    </div>
</section>

<section class="home-section">
    <div class="section-heading">
        <span class="section-label">What it does</span>
        <h2>Explore, manage, and understand course paths</h2>
    </div>
    <div class="feature-grid">
        <article class="feature-card">
            <h3>Course Catalog</h3>
            <p>Search structured course records, including course codes, credits, descriptions, prerequisites, and source links.</p>
            <a asp-controller="Courses" asp-action="Index">View courses</a>
        </article>
        <article class="feature-card">
            <h3>Student Profiles</h3>
            <p>Create student records with program details, catalog year, starting term, and preferred credit load.</p>
            <a asp-controller="Students" asp-action="Index">View students</a>
        </article>
        <article class="feature-card">
            <h3>Course Tracking</h3>
            <p>Connect students with selected courses to support a simple advising and planning workflow.</p>
            <a asp-controller="StudentCourses" asp-action="Index">View student courses</a>
        </article>
        <article class="feature-card">
            <h3>AI Course Advisor</h3>
            <p>Ask course planning questions and receive responses grounded in local course and schedule data.</p>
            <a asp-controller="Chat" asp-action="Index">Ask the advisor</a>
        </article>
    </div>
</section>

<section class="home-section home-split">
    <div>
        <span class="section-label">Technical highlights</span>
        <h2>Built as a full-stack academic advising portfolio project</h2>
        <p>
            The project demonstrates MVC routing, Razor views, controller actions, Entity Framework migrations,
            SQLite persistence, client-side JavaScript, and an external AI API integration.
        </p>
    </div>
    <ul class="tech-list">
        <li>C# and ASP.NET Core MVC</li>
        <li>Entity Framework Core migrations</li>
        <li>SQLite local database</li>
        <li>Razor views with Bootstrap styling</li>
        <li>Gemini API-backed chat workflow</li>
    </ul>
</section>
