@model OSUClassPath.Models.StudentCourse

@{
    ViewData["Title"] = "Course Details";
}

<section class="info-page">
    <div class="section-heading">
        <span class="section-label" data-i18n="studentCoursesEyebrow">Course tracking</span>
        <h1>@Model.Course?.CourseCode</h1>
        <p>@Model.Course?.Title</p>
    </div>

    <div class="data-card">
        <dl class="row mb-0">
            <dt class="col-sm-3" data-i18n="status">Status</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Status)</dd>
            <dt class="col-sm-3" data-i18n="term">Term</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Term)</dd>
            <dt class="col-sm-3" data-i18n="grade">Grade</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Grade)</dd>
        </dl>
    </div>

    <div class="home-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary" data-i18n="edit">Edit</a>
        <a asp-action="Index" class="btn btn-outline-primary" data-i18n="backToList">Back to list</a>
    </div>
</section>
