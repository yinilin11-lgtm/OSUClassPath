@model OSUClassPath.Models.StudentCourse

@{
    ViewData["Title"] = "Add Course";
}

<section class="info-page auth-page">
    <div class="section-heading">
        <span class="section-label" data-i18n="studentCoursesEyebrow">Course tracking</span>
        <h1 data-i18n="addCourseTitle">Add course</h1>
        <p data-i18n="addCourseCopy">Save a course to your personal planning workspace.</p>
    </div>

    <div class="admin-login-card">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <label class="form-label" asp-for="CourseId" data-i18n="course">Course</label>
            <select class="form-control" asp-for="CourseId" asp-items="ViewBag.CourseId"></select>
            <span class="text-danger" asp-validation-for="CourseId"></span>

            <label class="form-label" asp-for="Status" data-i18n="status">Status</label>
            <select class="form-control" asp-for="Status" asp-items="Html.GetEnumSelectList<CourseStatus>()"></select>
            <span class="text-danger" asp-validation-for="Status"></span>

            <label class="form-label" asp-for="Term" data-i18n="term">Term</label>
            <input class="form-control" asp-for="Term" />
            <span class="text-danger" asp-validation-for="Term"></span>

            <label class="form-label" asp-for="Grade" data-i18n="grade">Grade</label>
            <input class="form-control" asp-for="Grade" />
            <span class="text-danger" asp-validation-for="Grade"></span>

            <div class="auth-actions">
                <button type="submit" class="btn btn-primary" data-i18n="save">Save</button>
                <a asp-action="Index" class="btn btn-outline-primary" data-i18n="backToList">Back to list</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
