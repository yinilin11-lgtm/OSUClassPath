@model OSUClassPath.Models.StudentCourse

@{
    ViewData["Title"] = "Remove Course";
}

<section class="info-page">
    <div class="section-heading">
        <span class="section-label" data-i18n="studentCoursesEyebrow">Course tracking</span>
        <h1 data-i18n="removeCourseTitle">Remove course</h1>
        <p data-i18n="removeCourseCopy">Remove this course from your personal workspace?</p>
    </div>

    <div class="data-card">
        <strong>@Model.Course?.CourseCode</strong>
        <p class="mb-0">@Model.Course?.Title</p>
    </div>

    <form asp-action="Delete" class="home-actions">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger" data-i18n="delete">Delete</button>
        <a asp-action="Index" class="btn btn-outline-primary" data-i18n="backToList">Back to list</a>
    </form>
</section>
