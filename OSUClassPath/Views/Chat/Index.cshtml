@{
    ViewData["Title"] = "AI Course Advisor";
}

<section class="agent-page">
    <div class="agent-hero">
        <div class="agent-hero-copy">
            <span class="agent-eyebrow">OSU CoursePath AI Advisor</span>
            <h1>Plan CSE courses by requirement and track</h1>
            <p>
                Ask about core courses, prerequisites, technical electives, and focus areas such as AI,
                game development, software engineering, security, systems, and data.
            </p>
        </div>

        <div class="agent-hero-panel">
            <div>
                <span class="agent-panel-label">Dataset</span>
                <strong>133 OSU CSE courses</strong>
            </div>
            <div>
                <span class="agent-panel-label">Tracks</span>
                <strong>AI, Gaming, Security</strong>
            </div>
            <div>
                <span class="agent-panel-label">Status</span>
                <strong id="agentStatus">Ready</strong>
            </div>
        </div>
    </div>

    <div class="agent-workspace">
        <aside class="agent-sidebar" aria-label="Suggested questions">
            <h2>Suggested questions</h2>
            <button type="button" class="agent-suggestion" data-agent-question="I want to focus on AI. Which CSE courses should I consider?">
                AI course path
            </button>
            <button type="button" class="agent-suggestion" data-agent-question="Which courses fit a game development or graphics track?">
                Game / graphics track
            </button>
            <button type="button" class="agent-suggestion" data-agent-question="Which security technical electives are available?">
                Security electives
            </button>
            <button type="button" class="agent-suggestion" data-agent-question="What are the core CSE courses and core choices?">
                Core requirements
            </button>
        </aside>

        <div class="agent-card">
            <div class="agent-card-header">
                <div>
                    <h2>Course advisor chat</h2>
                    <p>Ask about course descriptions, prerequisites, academic plans, and student course progress.</p>
                </div>
                <span class="agent-live-dot" aria-hidden="true"></span>
            </div>

            <div class="agent-chat" id="agentMessages" aria-live="polite">
                <div class="agent-message agent-message-assistant">
                    <div class="agent-avatar">AI</div>
                    <div class="agent-bubble">
                        Hi, I am the OSU CoursePath AI advisor. Ask me about course information, prerequisites, or planning ideas based on the available course data.
                    </div>
                </div>
            </div>

            <form class="agent-composer" id="agentForm">
                <label class="visually-hidden" for="agentInput">Enter your question</label>
                <textarea id="agentInput"
                          rows="2"
                          placeholder="Ask a course question, such as: What is CSE 2221 about?"
                          required></textarea>
                <button type="submit" id="agentSubmit">Send</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/agentChat.js" asp-append-version="true"></script>
}
