@{
    ViewData["Title"] = "AI 課程助理";
}

<section class="agent-shell">
    <div class="agent-header">
        <div>
            <p class="agent-kicker">C# API + JavaScript Frontend</p>
            <h1>OSUClassPath AI Agent</h1>
            <p>
                你可以詢問課程內容、學分、先修條件，或請它幫你規劃修課方向。
            </p>
        </div>
        <span class="agent-status" id="agentStatus">Ready</span>
    </div>

    <div class="agent-chat" id="agentMessages" aria-live="polite">
        <div class="agent-message agent-message-assistant">
            <div class="agent-avatar">AI</div>
            <div class="agent-bubble">
                嗨，我是你的課程 AI agent。你可以問我像是「CSE 2221 需要什麼先修？」或「我想走軟體工程方向，該怎麼排課？」
            </div>
        </div>
    </div>

    <form class="agent-composer" id="agentForm">
        <label class="visually-hidden" for="agentInput">輸入問題</label>
        <textarea id="agentInput"
                  rows="2"
                  placeholder="輸入你的問題，例如：CSE 2221 是什麼？"
                  required></textarea>
        <button type="submit" id="agentSubmit">送出</button>
    </form>
</section>

@section Scripts {
    <script src="~/js/agentChat.js" asp-append-version="true"></script>
}
