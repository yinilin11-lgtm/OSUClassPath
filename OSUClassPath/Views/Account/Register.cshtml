@model OSUClassPath.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<section class="info-page auth-page">
    <div class="section-heading">
        <span class="section-label" data-i18n="registerEyebrow">Personal workspace</span>
        <h1 data-i18n="registerTitle">Create account</h1>
        <p data-i18n="registerCopy">Create your own OSU CoursePath workspace for saved courses and future planning history.</p>
    </div>

    <div class="admin-login-card">
        <form asp-action="Register" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <label class="form-label" asp-for="DisplayName"></label>
            <input class="form-control" asp-for="DisplayName" autocomplete="name" />
            <span class="text-danger" asp-validation-for="DisplayName"></span>

            <label class="form-label" asp-for="Email"></label>
            <input class="form-control" asp-for="Email" autocomplete="email" />
            <span class="text-danger" asp-validation-for="Email"></span>

            <label class="form-label" asp-for="AcademicYear">Current academic year</label>
            <select class="form-select" asp-for="AcademicYear">
                <option value="1">Year 1</option>
                <option value="2">Year 2</option>
                <option value="3">Year 3</option>
                <option value="4">Year 4</option>
                <option value="5">Year 5+</option>
            </select>
            <span class="text-danger" asp-validation-for="AcademicYear"></span>

            <label class="form-label" asp-for="Password"></label>
            <input class="form-control" asp-for="Password" autocomplete="new-password" />
            <span class="text-danger" asp-validation-for="Password"></span>

            <label class="form-label" asp-for="ConfirmPassword"></label>
            <input class="form-control" asp-for="ConfirmPassword" autocomplete="new-password" />
            <span class="text-danger" asp-validation-for="ConfirmPassword"></span>

            <div class="auth-actions">
                <button class="btn btn-primary" type="submit" data-i18n="registerButton">Create account</button>
                <a class="btn btn-outline-primary" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" data-i18n="loginButton">Log in</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
