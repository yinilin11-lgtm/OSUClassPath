                <input asp-for="CatalogYear" class="form-control" />
                <span asp-validation-for="CatalogYear" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StartingTerm" class="control-label"></label>
                <input asp-for="StartingTerm" class="form-control" />
                <span asp-validation-for="StartingTerm" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PreferredCredits" class="control-label"></label>
                <input asp-for="PreferredCredits" class="form-control" />
